# Copy this file to .env and fill in your values (never commit .env).

# Garmin Connect (required on first run; cached in .garth/ after login)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Supabase (same values as your production .env.production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Your Fagundo Training OS user id (default below is the dev account)
SYNC_USER_ID=5285440e-a3dd-4f29-9b09-29715f0a04fc

# How many days back to sync (default 30)
SYNC_DAYS=30
